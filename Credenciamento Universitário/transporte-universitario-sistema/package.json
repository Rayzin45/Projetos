{
  "name": "transporte-universitario-sistema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MVP acadêmico de transporte universitário: Express, PostgreSQL e JavaScript",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env src/setup.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "dependencies": {"express": "^5.1.0", "pg": "^8.16.3"}
}
